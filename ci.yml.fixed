# STAGED CI WORKFLOW — copy to .github/workflows/ci.yml when BLK-3 resolves.
#
# The connected GitHub App currently lacks the `workflows` permission. This
# file is the authoritative expanded workflow until the app can update files
# under .github/workflows/.

name: CI

on:
  push:
    branches: ["**"]
  pull_request:
  workflow_dispatch:

permissions:
  contents: read

env:
  # WinForge is intentionally stdlib-only, so the module cache is never needed
  # and the build must succeed with no network access to a module proxy.
  GOFLAGS: -mod=mod
  GOPROXY: off
  # Go source lives in cmd/ and internal/ plus the root package (embed.go).
  # Scoping packages explicitly keeps `go test ./...` from walking
  # node_modules/, where npm deps (e.g. flatted) ship .go files.
  GO_PKGS: ./cmd/... ./internal/... .

jobs:
  test:
    name: Test (Linux)
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v5
      - uses: actions/setup-go@v6
        with:
          go-version-file: go.mod
          check-latest: true
      - name: gofmt
        run: |
          unformatted="$(gofmt -l cmd internal embed.go)"
          if [ -n "$unformatted" ]; then
            echo "::error::These files are not gofmt-formatted:"
            echo "$unformatted"
            gofmt -d cmd internal embed.go
            exit 1
          fi
      - name: go vet
        run: go vet $GO_PKGS
      - name: go test
        run: go test $GO_PKGS
      - name: go test -race
        run: go test -race $GO_PKGS

  windows:
    name: Test (Windows)
    runs-on: windows-latest
    steps:
      - uses: actions/checkout@v5
      - uses: actions/setup-go@v6
        with:
          go-version-file: go.mod
          check-latest: true
      # Building and vetting on a real Windows runner is what catches the
      # GOOS=windows-only code that never compiles during Linux-only checks.
      - name: go build
        run: go build ./cmd/... ./internal/... .
      - name: go vet
        run: go vet ./cmd/... ./internal/... .
      - name: go test
        run: go test ./cmd/... ./internal/... .

  cross-compile:
    name: Cross-compile (${{ matrix.goos }}/${{ matrix.goarch }})
    runs-on: ubuntu-latest
    strategy:
      fail-fast: false
      matrix:
        include:
          - goos: windows
            goarch: amd64
          - goos: windows
            goarch: 386
          - goos: windows
            goarch: arm64
    steps:
      - uses: actions/checkout@v5
      - uses: actions/setup-go@v6
        with:
          go-version-file: go.mod
          check-latest: true
      - name: go build
        run: go build $GO_PKGS
        env:
          GOOS: ${{ matrix.goos }}
          GOARCH: ${{ matrix.goarch }}
      - name: go vet
        run: go vet $GO_PKGS
        env:
          GOOS: ${{ matrix.goos }}
          GOARCH: ${{ matrix.goarch }}
      - name: Build release binary
        if: matrix.goarch == 'amd64'
        run: >
          go build -trimpath
          -ldflags="-s -w -X winforge/internal/app.Version=${GITHUB_REF_NAME}-${GITHUB_SHA::7}"
          -o winforge.exe ./cmd/winforge
        env:
          GOOS: windows
          GOARCH: amd64
          CGO_ENABLED: "0"
      - name: Verify PE header and embedded assets
        if: matrix.goarch == 'amd64'
        run: |
          python3 tools/verify_binary.py winforge.exe --version "${{ github.ref_name }}-${GITHUB_SHA::7}"
      - name: Upload winforge.exe
        if: matrix.goarch == 'amd64'
        uses: actions/upload-artifact@v4
        with:
          name: winforge-windows-amd64
          path: winforge.exe
          if-no-files-found: error

  parity:
    name: Catalog parity
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v5
      - name: Catalog parity (must exit 0)
        run: python3 tools/catalog_parity.py
      - name: Generated installer validation
        run: python3 tools/generate_iss.py --check
      - name: Locale catalog validation
        run: python3 tools/extract_locales.py
      - name: Converter idempotence (dry-run must not want changes)
        run: |
          before="$(sha256sum config/tweaks.json)"
          python3 tools/web_catalog_to_engine.py --apply
          after="$(sha256sum config/tweaks.json)"
          if [ "$before" != "$after" ]; then
            echo "::error::tools/web_catalog_to_engine.py --apply changed config/tweaks.json — catalog drifted"
            git diff --stat config/tweaks.json
            exit 1
          fi

  web:
    name: Web app checks (Node 20)
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v5
      - uses: actions/setup-node@v5
        with:
          node-version: "20"
          cache: npm
      - name: Install dependencies
        run: npm ci
      - name: Production dependency audit
        run: npm audit --omit=dev --audit-level=high
      - name: Typecheck
        run: npm run typecheck
      - name: Lint
        run: npm run lint
      - name: Unit tests
        run: npm test
      # The production build must succeed with no DATABASE_URL (the DB pool is
      # lazily constructed so build-time page collection does not need a live
      # PostgreSQL instance).
      - name: Production build (no DATABASE_URL)
        run: npm run build
        env:
          DATABASE_URL: ""

  syntax:
    name: JSON and JavaScript syntax
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v5
      - uses: actions/setup-node@v5
        with:
          node-version: "20"
      - name: Check JavaScript syntax
        run: |
          status=0
          while IFS= read -r -d '' file; do
            node --check "$file" || status=1
          done < <(find web -name '*.js' -print0)
          exit $status
      - name: Check JSON syntax
        run: |
          status=0
          while IFS= read -r -d '' file; do
            python3 -c 'import json,sys; json.load(open(sys.argv[1]))' "$file" \
              || { echo "::error file=$file::invalid JSON"; status=1; }
          done < <(find . -name '*.json' -not -path './.git/*' -not -path './node_modules/*' -not -path './archive/*' -print0)
          exit $status
      - name: Check for whitespace errors
        run: git diff --check "$(git hash-object -t tree /dev/null)" HEAD
