# WinForge web control center environment configuration.
# Copy this file to .env and fill in the values.
#
# The Go engine (cmd/winforge) is stdlib-only and does NOT read this file;
# these variables are for the Next.js app only.

# PostgreSQL connection string used by Drizzle ORM.
# Required for `npm run dev`, `npm start`, and any page that queries the DB.
# `npm run build` does NOT require it — the connection pool is created lazily.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/winforge

# Optional: base URL of the running Go engine's dashboard API.
# The Next.js dev server proxies /engine/* to this address (see next.config.ts).
# Defaults to http://127.0.0.1:8696 (winforge serve).
# WINFORGE_ENGINE_URL=http://127.0.0.1:8696
