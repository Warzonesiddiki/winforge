<Window x:Class="WinForge.Elite.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WinForge.Elite.ViewModels"
        Title="WinForge Elite — Control Center"
        Width="1200" Height="760"
        MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Loaded="OnLoaded"
        Closing="OnClosing">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Navigation sidebar -->
        <Border Grid.Column="0" BorderBrush="#1F000000" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="16,20,16,12">
                    <TextBlock Text="WINFORGE ELITE" FontSize="18" FontWeight="Bold" />
                    <TextBlock Text="Control Center" FontSize="12" Opacity="0.6" />
                </StackPanel>

                <ListBox x:Name="ModuleList"
                         ItemsSource="{Binding Modules}"
                         SelectionChanged="OnModuleSelected"
                         BorderThickness="0"
                         Background="Transparent"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="16,8" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ModuleSummary}">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock Text="{Binding CountLabel}" FontSize="11" Opacity="0.55" Margin="0,1,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Main area -->
        <DockPanel Grid.Column="1" Margin="20,16,20,12">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                <Button DockPanel.Dock="Right"
                        Content="Refresh"
                        Command="{Binding RefreshCommand}"
                        IsEnabled="{Binding CanRefresh}"
                        Padding="16,6"
                        VerticalAlignment="Center" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding SectionTitle}" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="12" Opacity="0.6" Margin="0,2,0,0"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DockPanel>

            <StatusBar DockPanel.Dock="Bottom">
                <StatusBarItem>
                    <TextBlock Text="{Binding AdminStatus}" />
                </StatusBarItem>
                <Separator />
                <StatusBarItem>
                    <TextBlock Text="{Binding DatabasePath}" ToolTip="{Binding DatabasePath}" />
                </StatusBarItem>
            </StatusBar>

            <!-- Recent activity (module views for the selected section arrive in Phase 1 Step 3) -->
            <GroupBox Header="Recent Activity">
                <ListView ItemsSource="{Binding RecentActivity}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Time" Width="150"
                                            DisplayMemberBinding="{Binding ExecutedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}" />
                            <GridViewColumn Header="Operation" Width="220"
                                            DisplayMemberBinding="{Binding OperationName}" />
                            <GridViewColumn Header="Status" Width="90">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Failed" />
                                                    <Setter Property="Foreground" Value="#C42B1C" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Success}" Value="True">
                                                            <Setter Property="Text" Value="Success" />
                                                            <Setter Property="Foreground" Value="#107C10" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Details" Width="430"
                                            DisplayMemberBinding="{Binding Details}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </GroupBox>
        </DockPanel>
    </Grid>
</Window>
