<UserControl x:Class="WinForge.Elite.Views.PresetsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:WinForge.Elite.Models">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Refresh" Command="{Binding RefreshCommand}" IsEnabled="{Binding CanRefresh}" Padding="14,4" />
            <TextBlock Text="{Binding StatusMessage}" Opacity="0.6" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border CornerRadius="8" Background="#0F000000" Padding="14" Margin="4">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Model.Name}" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock VerticalAlignment="Center" Margin="8,0,0,0" FontSize="11" Opacity="0.7">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Standard" />
                                                <Setter Property="Foreground" Value="#717171" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Type}" Value="{x:Static models:PresetType.Gaming}">
                                                        <Setter Property="Text" Value="Gaming" />
                                                        <Setter Property="Foreground" Value="#107C10" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Type}" Value="{x:Static models:PresetType.Privacy}">
                                                        <Setter Property="Text" Value="Privacy Hardened" />
                                                        <Setter Property="Foreground" Value="#5C2E91" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Type}" Value="{x:Static models:PresetType.Work}">
                                                        <Setter Property="Text" Value="Work" />
                                                        <Setter Property="Foreground" Value="#0078D4" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="Protected" Foreground="#9D5D00" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsProtected}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                                <TextBlock Text="{Binding Model.Description}" TextWrapping="Wrap" Opacity="0.7" FontSize="12" Margin="0,4,0,0" />
                                <TextBlock Text="{Binding IncludedSummary}" Opacity="0.5" FontSize="11" Margin="0,2,0,0" />
                                <TextBlock Text="{Binding LastResult}" TextWrapping="Wrap" FontSize="11" Foreground="#9D5D00" />
                                <Button Content="Apply Preset"
                                        Command="{Binding DataContext.ApplyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        IsEnabled="{Binding CanApply}"
                                        HorizontalAlignment="Left"
                                        Margin="0,8,0,0"
                                        Padding="16,6"
                                        FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
