<UserControl x:Class="WinForge.Elite.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <!-- Live telemetry cards -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" CornerRadius="8" Background="#0F000000" Padding="12" Margin="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="CPU" FontSize="11" Opacity="0.6" />
                        <TextBlock Text="{Binding Telemetry.CpuPercent, StringFormat={}{0:F1}%}" FontSize="20" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" CornerRadius="8" Background="#0F000000" Padding="12" Margin="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="RAM" FontSize="11" Opacity="0.6" />
                        <TextBlock FontSize="20" FontWeight="SemiBold">
                            <Run Text="{Binding Telemetry.UsedRamGb, StringFormat={}{0:F1}}" />
                            <Run Text=" / " FontSize="14" />
                            <Run Text="{Binding Telemetry.TotalRamGb, StringFormat={}{0:F1} GB}" FontSize="14" />
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" CornerRadius="8" Background="#0F000000" Padding="12" Margin="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="UPTIME" FontSize="11" Opacity="0.6" />
                        <TextBlock Text="{Binding Telemetry.UptimeText}" FontSize="16" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" CornerRadius="8" Background="#0F000000" Padding="12">
                    <StackPanel>
                        <TextBlock Text="SYSTEM DRIVE" FontSize="11" Opacity="0.6" />
                        <TextBlock Text="{Binding Telemetry.SystemDrive}" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Telemetry.SystemDriveFreeGb, StringFormat={}{0:F0} GB free}" FontSize="12" Opacity="0.7" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Health score -->
            <GroupBox Header="Health Score" Margin="0,0,0,12">
                <StackPanel Margin="4">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Health.OverallScore}" FontSize="48" FontWeight="Bold" />
                        <TextBlock Text=" / 100" FontSize="16" VerticalAlignment="Bottom" Margin="4,0,0,12" Opacity="0.6" />
                        <TextBlock Text="{Binding Telemetry.MachineName}" FontSize="12" Opacity="0.6" Margin="16,0,0,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Telemetry.OsVersion}" FontSize="12" Opacity="0.6" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ProgressBar Height="10" Maximum="100" Value="{Binding Health.OverallScore}" Margin="0,4,0,12" />

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="44" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Security" VerticalAlignment="Center" />
                        <ProgressBar Grid.Row="0" Grid.Column="1" Height="8" Maximum="100" Value="{Binding Health.SecurityScore}" Margin="4" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding Health.SecurityScore}" VerticalAlignment="Center" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Performance" VerticalAlignment="Center" />
                        <ProgressBar Grid.Row="1" Grid.Column="1" Height="8" Maximum="100" Value="{Binding Health.PerformanceScore}" Margin="4" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Health.PerformanceScore}" VerticalAlignment="Center" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Cleanliness" VerticalAlignment="Center" />
                        <ProgressBar Grid.Row="2" Grid.Column="1" Height="8" Maximum="100" Value="{Binding Health.CleanlinessScore}" Margin="4" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Health.CleanlinessScore}" VerticalAlignment="Center" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Privacy" VerticalAlignment="Center" />
                        <ProgressBar Grid.Row="3" Grid.Column="1" Height="8" Maximum="100" Value="{Binding Health.PrivacyScore}" Margin="4" />
                        <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding Health.PrivacyScore}" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </GroupBox>

            <!-- Recent activity -->
            <Grid Margin="0,0,0,8">
                <Button HorizontalAlignment="Right" Content="Refresh" Command="{Binding RefreshCommand}" IsEnabled="{Binding CanRefresh}" Padding="14,4" />
                <TextBlock Text="Recent Activity" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
            </Grid>
            <ListView ItemsSource="{Binding RecentActivity}" MaxHeight="280">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Time" Width="140"
                                        DisplayMemberBinding="{Binding ExecutedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}" />
                        <GridViewColumn Header="Operation" Width="210"
                                        DisplayMemberBinding="{Binding OperationName}" />
                        <GridViewColumn Header="Status" Width="80">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Failed" />
                                                <Setter Property="Foreground" Value="#C42B1C" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Success}" Value="True">
                                                        <Setter Property="Text" Value="Success" />
                                                        <Setter Property="Foreground" Value="#107C10" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Details" Width="380"
                                        DisplayMemberBinding="{Binding Details}" />
                    </GridView>
                </ListView.View>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</UserControl>
