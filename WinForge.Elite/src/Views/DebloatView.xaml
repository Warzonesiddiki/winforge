<UserControl x:Class="WinForge.Elite.Views.DebloatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:WinForge.Elite.Models">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <ComboBox Width="180"
                      ItemsSource="{Binding Categories}"
                      SelectedItem="{Binding SelectedCategory}"
                      Margin="0,0,8,0" />
            <Button Content="Select All in Category"
                    Command="{Binding SelectAllCommand}"
                    CommandParameter="{Binding SelectedCategory}"
                    Margin="0,0,8,0"
                    Padding="12,4" />
            <Button Content="Remove Selected"
                    Command="{Binding RemoveSelectedCommand}"
                    Margin="0,0,8,0"
                    Padding="12,4"
                    FontWeight="SemiBold" />
            <Button Content="Refresh" Command="{Binding RefreshCommand}" IsEnabled="{Binding CanRefresh}" Padding="14,4" />
        </StackPanel>

        <TextBlock DockPanel.Dock="Bottom"
                   Text="{Binding StatusMessage}"
                   Opacity="0.6"
                   TextWrapping="Wrap"
                   Margin="0,8,0,0" />

        <ListBox ItemsSource="{Binding Items}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <CheckBox Content="{Binding Package.DisplayName}"
                                          IsChecked="{Binding IsSelected}"
                                          IsEnabled="{Binding CanSelect}"
                                          FontWeight="SemiBold"
                                          VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource RiskBadgeStyle}" />
                            </StackPanel>
                            <TextBlock Text="{Binding Package.Category}" Opacity="0.6" FontSize="12" Margin="22,1,0,0" />
                        </StackPanel>

                        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="11" Margin="0,0,8,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Installed" />
                                    <Setter Property="Foreground" Value="#107C10" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Package.Status}" Value="{x:Static models:PackageStatus.Removed}">
                                            <Setter Property="Text" Value="Removed" />
                                            <Setter Property="Foreground" Value="#717171" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Package.Status}" Value="{x:Static models:PackageStatus.Protected}">
                                            <Setter Property="Text" Value="Protected" />
                                            <Setter Property="Foreground" Value="#9D5D00" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <Button Grid.Column="2" Content="Reinstall" VerticalAlignment="Center" Padding="12,4"
                                Command="{Binding DataContext.ReinstallCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                CommandParameter="{Binding}"
                                IsEnabled="{Binding CanReinstall}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowReinstall}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
