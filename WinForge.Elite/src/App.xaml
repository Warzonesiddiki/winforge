<Application x:Class="WinForge.Elite.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             xmlns:models="clr-namespace:WinForge.Elite.Models">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemeResources />
                <ui:XamlControlsResources />
            </ResourceDictionary.MergedDictionaries>

            <!-- Shared risk-level badge used by the Tweaks, Debloat, and Privacy lists.
                 Binds to the item wrapper's Risk property (RiskLevel). -->
            <Style x:Key="RiskBadgeStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="10" />
                <Setter Property="Padding" Value="6,2" />
                <Setter Property="Margin" Value="8,0,0,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Text" Value="Low" />
                <Setter Property="Foreground" Value="#107C10" />
                <Setter Property="Background" Value="#1F107C10" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Risk}" Value="{x:Static models:RiskLevel.Medium}">
                        <Setter Property="Text" Value="Medium" />
                        <Setter Property="Foreground" Value="#9D5D00" />
                        <Setter Property="Background" Value="#1F9D5D00" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Risk}" Value="{x:Static models:RiskLevel.High}">
                        <Setter Property="Text" Value="High" />
                        <Setter Property="Foreground" Value="#C42B1C" />
                        <Setter Property="Background" Value="#1FC42B1C" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Risk}" Value="{x:Static models:RiskLevel.Expert}">
                        <Setter Property="Text" Value="Expert" />
                        <Setter Property="Foreground" Value="#5C2E91" />
                        <Setter Property="Background" Value="#1F5C2E91" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
